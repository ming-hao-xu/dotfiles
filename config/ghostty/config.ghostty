# Appearance
theme = Catppuccin Mocha
font-size = 16
font-codepoint-map = U+2E80-U+9FFF,U+FF00-U+FFEF=Noto Sans CJK SC
window-padding-x = 10
window-padding-balance = true

# Cursor & Mouse
cursor-style-blink = false
mouse-hide-while-typing = true

# Keyboard
macos-option-as-alt = left

# Shell Integration
shell-integration-features = ssh-terminfo,ssh-env,sudo,no-cursor

# Quick Terminal
keybind = global:f5=toggle_quick_terminal
quick-terminal-position = bottom
quick-terminal-size = 45%
